<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>IviCli.TestKit</RootNamespace>
    <AssemblyName>IviCli.TestKit</AssemblyName>
    <!--
      Explicitly opt out of IsTestProject auto-detection. TestKit is a
      reusable library that ships xUnit-aware helpers (RequiresAttribute,
      etc.) but is not itself a test project — without this, the xUnit
      runner-stack ItemGroup in tests/Directory.Build.props would inject
      the xunit.v3 package, which turns a project into a test executable.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IviCli.Domain\IviCli.Domain.csproj" />
    <ProjectReference Include="..\..\src\IviCli.Application\IviCli.Application.csproj" />
    <ProjectReference Include="..\..\src\IviCli.Backends.Fake\IviCli.Backends.Fake.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
</Project>
