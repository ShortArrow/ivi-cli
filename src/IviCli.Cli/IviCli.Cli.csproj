<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>IviCli.Cli</RootNamespace>
    <AssemblyName>ivicli</AssemblyName>
  </PropertyGroup>

  <!--
    NuGet packaging metadata for the `dotnet tool install -g ivi-cli`
    distribution channel. The parent src/Directory.Build.props sets
    IsPackable=false for every assembly so library projects don't
    publish to nuget.org; this csproj opts back in explicitly because
    it is the user-facing tool entry point.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>ivi-cli</PackageId>
    <ToolCommandName>ivicli</ToolCommandName>
    <Title>ivi-cli</Title>
    <Description>VISA/IVI instrument CLI with HiSLIP / VXI-11 / SOCKET gateways, scenario-driven mock backend, and Management HTTP/WebSocket API.</Description>
    <Authors>ShortArrow</Authors>
    <PackageProjectUrl>https://github.com/ShortArrow/ivi-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShortArrow/ivi-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>visa;ivi;scpi;hislip;vxi-11;cli;instrument;test-automation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    CopyToOutputDirectory puts the licence texts and the third-party
    attribution into the publish layout, which is what the per-RID release
    archives are zipped from and what the container image copies in. The
    bundled assemblies' licences require that attribution to travel with
    every copy of the binaries, not only with the repository.
  -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None
      Include="..\..\LICENSE-MIT"
      Pack="true"
      PackagePath="\"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\LICENSE-APACHE"
      Pack="true"
      PackagePath="\"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\THIRD-PARTY-NOTICES.md"
      Pack="true"
      PackagePath="\"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IviCli.Application\IviCli.Application.csproj" />
    <ProjectReference Include="..\IviCli.Infrastructure\IviCli.Infrastructure.csproj" />
    <ProjectReference Include="..\IviCli.Backends.Local\IviCli.Backends.Local.csproj" />
    <ProjectReference Include="..\IviCli.Backends.Replay\IviCli.Backends.Replay.csproj" />
    <ProjectReference Include="..\IviCli.Backends.Fake\IviCli.Backends.Fake.csproj" />
    <ProjectReference Include="..\IviCli.Backends.Socket\IviCli.Backends.Socket.csproj" />
    <ProjectReference Include="..\IviCli.Backends.HiSlip\IviCli.Backends.HiSlip.csproj" />
    <ProjectReference Include="..\IviCli.Backends.Vxi11\IviCli.Backends.Vxi11.csproj" />
    <ProjectReference Include="..\IviCli.Backends.Lxi\IviCli.Backends.Lxi.csproj" />
    <ProjectReference Include="..\IviCli.Api\IviCli.Api.csproj" />
    <ProjectReference Include="..\IviCli.Server\IviCli.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>
</Project>
