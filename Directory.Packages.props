<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime — production">
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <!--
      The IVI Foundation's own VISA.NET shared components (the Ivi.Visa
      abstraction), published by the foundation's verified nuget.org
      account. Vendor VISA implementations are never referenced; the
      shared components discover them at runtime. Pinned to the same
      release line as the installed shared components (8.0.x).
    -->
    <PackageVersion Include="IviFoundation.Visa" Version="8.0.2" />
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="10.0.11" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="LXI discovery (ADR 0008, Batch W)">
    <!-- Makaretu.Dns is a pure-managed mDNS / DNS-SD client; .Multicast
         pulls in the wire-level UDP transport bits. -->
    <PackageVersion Include="Makaretu.Dns" Version="2.0.1" />
    <PackageVersion Include="Makaretu.Dns.Multicast" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry (ADR 0040)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup Label="Test stack — xUnit + assertions">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Label="Test stack — coverage / property / snapshot / arch">
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.1.0" />
    <PackageVersion Include="Verify.Xunit" Version="31.12.5" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup Label="Test stack — IO abstractions">
    <PackageVersion Include="TestableIO.System.IO.Abstractions" Version="22.2.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup Label="Logging abstractions for tests">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Time abstractions for tests">
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>
</Project>
